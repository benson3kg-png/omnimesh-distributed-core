#!ipxe

# iPXE Network Boot Configuration Matrix
# Target Environment: Volatile Hardware RAM Storage

echo [INIT]: Initializing network interface telemetry...

:dhcp_loop
dhcp || goto retry

:boot_stage
echo [NET]: Node IP configuration assigned: ${net0/ip}
echo [NET]: Fetching wimboot components from cloud orchestration layer...

set cloud_host https://sovereign-fleet.io

kernel ${cloud_host}/wimboot
initrd ${cloud_host}/BCD          BCD
initrd ${cloud_host}/boot.sdi     boot.sdi
initrd ${cloud_host}/boot.wim     boot.wim

echo [RAMSTAGE]: Executing boot initialization loop...
boot || goto fail

:retry
echo [WARN]: DHCP handshake timeout occurred. Re-entering loop circuit...
sleep 5
goto dhcp_loop

:fail
echo [ERR]: Preboot deployment transmission failed. Dropping connection to shell.
shell
